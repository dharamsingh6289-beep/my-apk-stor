<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My APK Store</title>
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">

<style>
  :root { --accent:#01875f; --bg:#f6f8fc; --card:#ffffff; --text:#1a1c1e; }
  * { box-sizing:border-box; margin:0; padding:0; font-family:'Roboto',sans-serif; }
  body { background:var(--bg); color:var(--text); padding-bottom:50px; }

  header {
    background:#fff; padding:14px 20px; display:flex; align-items:center;
    justify-content:space-between; border-bottom:1px solid #e3e6ea; position:sticky; top:0; z-index:10;
  }
  .logo { font-size:18px; font-weight:700; color:var(--accent); cursor:pointer; user-select:none; }
  .owner-badge { background:var(--accent); color:#fff; font-size:10px; padding:4px 8px; border-radius:10px; display:none; }

  .container { padding:20px; max-width:800px; margin:0 auto; }
  .app-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(150px,1fr)); gap:16px; margin-top:15px; }
  
  .app-card {
    background:var(--card); padding:12px; border-radius:14px; border:1px solid #e3e6ea;
    display:flex; flex-direction:column; position:relative;
  }
  .app-icon { width:100%; aspect-ratio:1; border-radius:12px; object-fit:cover; margin-bottom:8px; background:#eee; }
  .app-title { font-size:14px; font-weight:700; margin-bottom:4px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .app-size { font-size:11px; color:#666; margin-bottom:10px; }
  
  .btn {
    width:100%; padding:9px; background:var(--accent); color:#fff; border:none;
    border-radius:8px; font-weight:700; font-size:12px; cursor:pointer; text-align:center; text-decoration:none; display:block;
  }
  .del-btn {
    position:absolute; top:4px; right:4px; background:#ea4335; color:#fff; border:none;
    width:22px; height:22px; border-radius:50%; font-weight:bold; cursor:pointer; display:none;
  }

  .support-box { background:#fff; padding:15px; border-radius:12px; text-align:center; margin-top:25px; border:1px solid #e3e6ea; }
  .support-btn { display:inline-block; margin-top:8px; padding:8px 16px; background:#4285f4; color:#fff; border-radius:20px; text-decoration:none; font-size:12px; font-weight:bold; }

  .fab {
    position:fixed; bottom:20px; right:20px; width:50px; height:50px; background:var(--accent);
    color:#fff; font-size:24px; border:none; border-radius:50%; cursor:pointer; display:none;
    box-shadow:0 4px 10px rgba(0,0,0,0.3); align-items:center; justify-content:center;
  }

  .modal {
    position:fixed; inset:0; background:rgba(0,0,0,0.5); display:none;
    align-items:center; justify-content:center; padding:20px; z-index:20;
  }
  .modal-content { background:#fff; padding:20px; border-radius:14px; width:100%; max-width:380px; }
  .modal-content input {
    width:100%; padding:8px; margin:6px 0 12px; border:1px solid #ccc; border-radius:6px; font-size:13px;
  }
  .modal-btns { display:flex; gap:8px; }
  .modal-btns button { flex:1; padding:8px; border:none; border-radius:6px; font-weight:bold; cursor:pointer; }
</style>
</head>
<body>

<header>
  <!-- Secret Owner Login: Logo par 3 baar jaldi click karein -->
  <div class="logo" id="logoBtn">▶ My APK Store</div>
  <span class="owner-badge" id="ownerBadge">Owner Mode</span>
</header>

<div class="container">
  <h3>All Mobile Apps & Games</h3>
  <div class="app-grid" id="appGrid"></div>

  <div class="support-box">
    <p style="font-size:13px;color:#555;">Need Help with Download?</p>
    <a href="mailto:ayush6289134@gmail.com" class="support-btn">📧 Contact Support</a>
  </div>
</div>

<button class="fab" id="fabBtn" onclick="showModal('addModal')">+</button>

<!-- Login Modal -->
<div class="modal" id="loginModal">
  <div class="modal-content">
    <h3>Owner Login</h3>
    <input type="password" id="passInput" placeholder="Passcode (appadda123)">
    <div class="modal-btns">
      <button onclick="hideModal('loginModal')">Cancel</button>
      <button style="background:var(--accent);color:#fff;" onclick="loginOwner()">Login</button>
    </div>
  </div>
</div>

<!-- Add App Modal -->
<div class="modal" id="addModal">
  <div class="modal-content">
    <h3>Add New App</h3>
    
    <label style="font-size:12px;">App Name</label>
    <input type="text" id="appName" placeholder="e.g. My Quiz Game">

    <label style="font-size:12px;">App Logo (Gallery)</label>
    <input type="file" id="appLogoFile" accept="image/*">

    <label style="font-size:12px;">Size</label>
    <input type="text" id="appSize" placeholder="e.g. 18 MB">

    <label style="font-size:12px;">Download Link (Google Drive / Direct Link)</label>
    <input type="text" id="appLink" placeholder="Paste APK link here">

    <div class="modal-btns">
      <button onclick="hideModal('addModal')">Cancel</button>
      <button style="background:var(--accent);color:#fff;" onclick="saveApp()">Save App</button>
    </div>
  </div>
</div>

<script>
let isOwner = false;

// Google Drive Link Handler
function getDirectLink(link) {
  if (!link) return '';
  let clean = link.trim();
  if (clean.includes('drive.google.com') && clean.includes('/file/d/')) {
    const fileId = clean.split('/file/d/')[1].split('/')[0];
    return `https://drive.google.com/uc?export=download&id=${fileId}`;
  }
  return clean;
}

// Initial Apps List
let defaultApps = [
  {
    id: 1,
    name: "ONE LINE DRAW GAME QUIZ",
    size: "18 MB",
    icon: "https://via.placeholder.com/150",
    link: "https://drive.google.com/uc?export=download&id=1UEY_aJD0PMKuk-yeQ9LmpTr6W08YLprh"
  }
];

let apps = JSON.parse(localStorage.getItem('vercel_apk_apps')) || defaultApps;

function render() {
  const grid = document.getElementById('appGrid');
  grid.innerHTML = '';

  apps.forEach(app => {
    const directUrl = getDirectLink(app.link);
    grid.innerHTML += `
      <div class="app-card">
        ${isOwner ? `<button class="del-btn" style="display:block" onclick="deleteApp(${app.id})">✕</button>` : ''}
        <img src="${app.icon}" class="app-icon">
        <div class="app-title">${app.name}</div>
        <div class="app-size">${app.size}</div>
        <button class="btn" onclick="startDownload('${directUrl}', '${app.name}')">Download</button>
      </div>
    `;
  });

  document.getElementById('fabBtn').style.display = isOwner ? 'flex' : 'none';
  document.getElementById('ownerBadge').style.display = isOwner ? 'inline-block' : 'none';
}

function startDownload(url, name) {
  const a = document.createElement('a');
  a.href = url;
  a.target = '_blank';
  a.download = name + '.apk';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
}

function readFile(file) {
  return new Promise((resolve) => {
    const reader = new FileReader();
    reader.onload = () => resolve(reader.result);
    reader.readAsDataURL(file);
  });
}

async function saveApp() {
  const name = document.getElementById('appName').value.trim();
  const size = document.getElementById('appSize').value.trim();
  const link = document.getElementById('appLink').value.trim();
  const fileInput = document.getElementById('appLogoFile');

  if(!name || !link) { alert("App Name aur Download Link required hai!"); return; }

  let iconUrl = "https://via.placeholder.com/150";
  if(fileInput.files && fileInput.files[0]) {
    iconUrl = await readFile(fileInput.files[0]);
  }

  apps.push({ id: Date.now(), name, size: size || 'APK', icon: iconUrl, link });
  localStorage.setItem('vercel_apk_apps', JSON.stringify(apps));

  hideModal('addModal');
  document.getElementById('appName').value = '';
  document.getElementById('appSize').value = '';
  document.getElementById('appLink').value = '';
  document.getElementById('appLogoFile').value = '';
  
  render();
}

function deleteApp(id) {
  apps = apps.filter(a => a.id !== id);
  localStorage.setItem('vercel_apk_apps', JSON.stringify(apps));
  render();
}

function showModal(id) { document.getElementById(id).style.display = 'flex'; }
function hideModal(id) { document.getElementById(id).style.display = 'none'; }

let clicks = 0;
document.getElementById('logoBtn').onclick = () => {
  clicks++;
  if(clicks === 3) {
    clicks = 0;
    if(!isOwner) showModal('loginModal');
    else { isOwner = false; render(); }
  }
  setTimeout(() => clicks = 0, 1000);
};

function loginOwner() {
  const pass = document.getElementById('passInput').value;
  if(pass === "appadda123") {
    isOwner = true;
    hideModal('loginModal');
    render();
  } else {
    alert("Wrong Passcode!");
  }
}

render();
</script>
</body>
</html>
